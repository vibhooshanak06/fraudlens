PORT=4000

# MySQL — local installation (run scripts/init-mysql.js once to create tables)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_root_password_here
MYSQL_DB=fraudlens

# MongoDB — local or Atlas
# Local:  MONGO_URI=mongodb://localhost:27017/fraudlens
# Atlas:  MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?appName=FraudLens
MONGO_URI=mongodb://localhost:27017/fraudlens

# AI Engine — local FastAPI service (default: http://localhost:8000)
AI_ENGINE_URL=http://localhost:8000

# JWT — use a long random string in production
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Supabase Storage (PDFs are stored here — create a free project at https://supabase.com)
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET=papers
