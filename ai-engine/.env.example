# MongoDB — local or Atlas
# Local:  MONGO_URI=mongodb://localhost:27017/fraudlens
# Atlas:  MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?appName=FraudLens
MONGO_URI=mongodb://localhost:27017/fraudlens

# OpenRouter API key — get a free key at https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here

# FAISS index storage path (relative to ai-engine/)
FAISS_STORE_PATH=./faiss_indexes

# LLM model (free tier)
OPENROUTER_MODEL=liquid/lfm-2.5-1.2b-instruct:free
